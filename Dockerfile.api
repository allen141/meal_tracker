FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
ARG BUILD_VERSION=development
ENV NODE_ENV=production \
    PORT=3000 \
    DB_PATH=/var/lib/macroflow/macroflow.db \
    BUILD_VERSION=${BUILD_VERSION}
LABEL org.opencontainers.image.revision=${BUILD_VERSION}
WORKDIR /app
RUN mkdir -p /var/lib/macroflow && chown -R node:node /app /var/lib/macroflow
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json db.js server.js migrate.js ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health/ready >/dev/null || exit 1
CMD ["node", "server.js"]
